rules_version = '2';

// Single-user app, everything under users/{uid}. The principle holding all of
// this up: the client never decides how much it can spend. The fields that
// govern the budget are written only by the Admin SDK, which bypasses these
// rules entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase Auth accepts any Google account, so without this list anyone
    // with the link could sign up and write to the project.
    //
    // These are uids, not emails, because this repo is public: a uid is an
    // opaque identifier that reveals nothing about anyone and is useless
    // without the Google account behind it. To add someone: let them sign in
    // once (they will be denied), read their uid from `firebase auth:export`,
    // and add it here and in storage.rules.
    function allowed() {
      return [
        'oDpYcDSYHARdX5k5R76al8z4QMo2',
      ];
    }

    function isOwner(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && uid in allowed();
    }

    function touches(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Profile. The client may write its own model photo, not its own budget.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(['imageBudget', 'imagesGenerated']);
      allow update: if isOwner(uid)
                    && !touches(['imageBudget', 'imagesGenerated']);
      allow delete: if false;
    }

    match /users/{uid}/garments/{garmentId} {
      allow read, write: if isOwner(uid);
    }

    // renderUrl costs money: it is written by the Cloud Function after the
    // render has been charged against the budget, never by the client.
    match /users/{uid}/outfits/{outfitId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !('renderUrl' in request.resource.data);
      allow update: if isOwner(uid) && !touches(['renderUrl']);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/wearLog/{date} {
      allow read, write: if isOwner(uid);
    }

    // Spending ledger: read for the budget screen, written only by the server.
    match /users/{uid}/spending/{entryId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Per-user rate limiting: server-side counters.
    match /users/{uid}/rateLimits/{window} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
