# Copiar a .env.local y llenar con los valores de la app web del proyecto
# Firebase (Configuracion del proyecto -> Tus apps -> Web).
#
# Estas claves son publicas por diseno: viajan en el bundle. Lo que protege
# los datos son las reglas de Firestore y Storage, no el secreto de la apiKey.
# Las keys que SI son secretas (Gemini) viven solo en las Cloud Functions.

VITE_FIREBASE_API_KEY=
# Dejar el <proyecto>.firebaseapp.com por defecto salvo que sepas lo que sigue.
#
# Apuntarlo al mismo origen que sirve la app (ej. ropero.web.app) hace que el
# login por redirect sobreviva a Safari en iOS instalado, pero NO alcanza con
# cambiar esta linea: el redirect_uri pasa a ser <ese origen>/__/auth/handler y
# hay que registrarlo a mano en el cliente OAuth del proyecto
# (APIs y servicios -> Credenciales -> Web client auto created by Google
# Service -> URI de redireccionamiento autorizados). Sin ese registro, Google
# responde 400 redirect_uri_mismatch y no hay login.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
