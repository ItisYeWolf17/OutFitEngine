rules_version = '2';

// Usuario unico, datos bajo usuarios/{uid}. El principio que sostiene todo
// esto: el cliente nunca decide cuanto puede gastar. Los campos que controlan
// el presupuesto solo los escribe el Admin SDK, que ignora estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase Auth acepta cualquier cuenta de Google, asi que sin esta lista
    // cualquiera con el enlace podria registrarse y escribir en el proyecto.
    //
    // Va por uid y no por correo porque este repo es publico: un uid es un
    // identificador opaco que no revela quien es nadie y no sirve de nada sin
    // la cuenta de Google detras. Para sumar a alguien: que entre una vez
    // (va a recibir permiso denegado), sacar su uid con
    // `firebase auth:export`, y agregarlo aca y en storage.rules.
    function permitidos() {
      return [
        'oDpYcDSYHARdX5k5R76al8z4QMo2',
      ];
    }

    // Cada quien ve solo su propio /usuarios/{uid}: la lista dice quien entra,
    // no quien ve que.
    function esDueno(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && uid in permitidos();
    }

    function tocaCampos(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // Perfil. El cliente puede escribir su foto modelo, no su presupuesto.
    match /usuarios/{uid} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid)
                    && !request.resource.data.keys().hasAny(['presupuestoImagenes', 'imagenesGeneradas']);
      allow update: if esDueno(uid)
                    && !tocaCampos(['presupuestoImagenes', 'imagenesGeneradas']);
      allow delete: if false;
    }

    match /usuarios/{uid}/prendas/{prendaId} {
      allow read, write: if esDueno(uid);
    }

    // renderUrl vale dinero: lo escribe la Cloud Function despues de cobrar
    // el render contra el presupuesto, nunca el cliente.
    match /usuarios/{uid}/outfits/{outfitId} {
      allow read: if esDueno(uid);
      allow create: if esDueno(uid) && !('renderUrl' in request.resource.data);
      allow update: if esDueno(uid) && !tocaCampos(['renderUrl']);
      allow delete: if esDueno(uid);
    }

    match /usuarios/{uid}/registro/{fecha} {
      allow read, write: if esDueno(uid);
    }

    // Bitacora de gasto: se lee para la pantalla de presupuesto, se escribe
    // solo desde el servidor.
    match /usuarios/{uid}/gastos/{gastoId} {
      allow read: if esDueno(uid);
      allow write: if false;
    }

    // Rate limiting por usuario: contadores del lado del servidor.
    match /usuarios/{uid}/limites/{ventana} {
      allow read: if esDueno(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
